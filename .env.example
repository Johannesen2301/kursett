# Kopier denne fila til .env.local og fyll inn dine egne verdier fra Supabase.
# (Prosjekt → Settings → API)
#
# MERK: anon-nøkkelen er trygg å ha i frontend — den er beskyttet av
# Row Level Security i Supabase. Dette er IKKE det samme som en hemmelig
# API-nøkkel (f.eks. Anthropic), som ALDRI skal ligge i frontend.

VITE_SUPABASE_URL=https://ditt-prosjekt.supabase.co
VITE_SUPABASE_ANON_KEY=din-anon-nokkel
